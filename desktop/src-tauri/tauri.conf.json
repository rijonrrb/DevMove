{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DevMove",
  "version": "0.1.1",
  "identifier": "com.devmove.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "DevMove — Windows Migration",
        "width": 1320,
        "height": 850,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "backgroundColor": "#f7f8fa"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}